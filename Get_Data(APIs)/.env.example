# Copy this file to .env (same folder) and fill in the two values.
# Never commit .env or share it.
ONTRAPORT_API_KEY=
ONTRAPORT_APP_ID=

# Safety limits - Ontraport allows 180 requests/min for the WHOLE account (shared with Make.com + forms)
ONTRAPORT_MAX_RPM=90        # max requests per minute these scripts send
ONTRAPORT_RESERVE=60        # pause when the account has this many calls left in the current minute
ONTRAPORT_FIELD_CHUNK=150   # fields per request; lower to 80 if you get error 400/414

# Timezone used by make_readable.py to show dates (Ontraport stores UTC timestamps)
ONTRAPORT_TIMEZONE=America/New_York

# Line placed between merged values in one cell (several notes, tags, multi-select answers)
ONTRAPORT_DIVIDER=--------------------

# Clean junk values in the readable/required files (raw backup never changes; every change logged
# in <object>_cleanup_log.csv): [add2]-style form placeholders, web-encoded text like Lorraine%0ACampos
ONTRAPORT_CLEAN_VALUES=1
